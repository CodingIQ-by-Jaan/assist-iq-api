# --- Base de datos (Supabase) ---
# App (pooler de Supabase, modo transacción, puerto 6543)
DATABASE_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones (conexión directa, puerto 5432)
DIRECT_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- JWT (usar secretos distintos y largos: openssl rand -base64 48) ---
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-1"
JWT_REFRESH_SECRET="cambiar-por-un-secreto-largo-2"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# --- CORS ---
# Lista separada por comas. Acepta comodín *  (ej: https://*-assistiq-web.vercel.app)
CORS_ORIGINS="http://localhost:5173,https://app.tudominio.com"

# --- Cookie del refresh token ---
# Dominio raíz compartido entre web y api (ej: .tudominio.com). Vacío en local.
COOKIE_DOMAIN=""
# lax (mismo sitio) | none (solo para previews en dominios distintos)
COOKIE_SAMESITE="lax"

# --- Otros ---
NODE_ENV="development"
PORT="3000"
SWAGGER_ENABLED="true"

# --- Seed (super admin inicial) ---
SEED_ADMIN_EMAIL="admin@codingiq.com"
SEED_ADMIN_PASSWORD="CambiarEstaClave123!"
SEED_ADMIN_NOMBRE="Administrador"
